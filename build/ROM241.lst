 1662 064165             ! ============================================================
 1663 064165             ! NATIVE HP-85 KEY-LABEL PANEL
 1664 064165             !
 1665 064165             ! LEG1..LEG4 are the bottom row (K1..K4).
 1666 064165             ! LEG5..LEG8 are the shifted/upper row (K5..K8).
 1667 064165             ! Each hardware slot is eight characters wide.  PRINTER85 deliberately uses
 1668 064165             ! at most seven visible characters and leaves the final byte blank so adjacent
 1669 064165             ! labels remain visually separated.
 1670 064165             ! ============================================================
 1671 064165             
 1672 064165             
 1673 064165             ! ------------------------------------------------------------
 1674 064165             ! KREFR -- update PRINTER85 labels when PRTKEYS owns the panel.
 1675 064165             !
 1676 064165             ! Always updates LEGEND/LEGEN2 while active.  KREDR performs a visible KEY LABEL
 1677 064165             ! redraw only in alpha mode; graphics mode is never disturbed.
 1678 064165             ! ------------------------------------------------------------
 1679 064165             
 1680 064165 230         KREFR   BIN
 1681 064166 114 261 154         LDMD R14,=BAS241
      064171 205 
 1682 064172 120 014 264         LDBD R20,X14,KHACT
      064175 010 000 
 1683 064177 310 000             CMB R20,=0
 1684 064201 367 006             JZR KRFRT
 1685 064203             
 1686 064203 316 247 150         JSB =KLABS
 1687 064206 316 212 150         JSB =KREDR
 1688 064211             
 1689 064211 236         KRFRT   RTN
 1690 064212             
 1691 064212             
 1692 064212             ! ------------------------------------------------------------
 1693 064212             ! KREDR -- invoke the native HP-85 KEY LABEL runtime only in alpha mode.
 1694 064212             !
 1695 064212             ! CRTWRS bit 7: 0=alpha, 1=graphics.  ROMJSB is used deliberately here because
 1696 064212             ! KEYLA. is a system runtime whose external-ROM calling contract is not
 1697 064212             ! explicitly documented in the assembler manual.
 1698 064212             ! ------------------------------------------------------------
