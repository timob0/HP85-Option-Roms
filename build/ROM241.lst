 3982 073172             ! READROW
 3983 073172             !
 3984 073172             ! Read the complete 256-pixel physical scanline:
 3985 073172             !
 3986 073172             !       32 sequential CRT bytes -> ROWBUF
 3987 073172             !
 3988 073172             !
 3989 073172             ! Input:
 3990 073172             !
 3991 073172             !       R46/R47 = physical CRT row-base nibble address
 3992 073172             !
 3993 073172             !
 3994 073172             ! BREAD-style strategy:
 3995 073172             !
 3996 073172             !       BYTCR! once
 3997 073172             !
 3998 073172             !       CRTFLG = 0:  repeated INCHR
 3999 073172             !       CRTFLG = 1:  repeated INCHR-
 4000 073172             !
 4001 073172             ! Both routines return the CRT byte in R32 and advance CRTBAD.
 4002 073172             ! The mode decision is made once per scanline, not once per byte.
 4003 073172             ! ============================================================
 4004 073172             
 4005 073172 230         READROW BIN
