  173 060216 134 260 231         LDBD R34,=ROMFL
      060221 202 
  174 060222 310 000             CMB R34,=0
  175 060224 367 005             JZR INIPWR
  176 060226             
  177 060226 310 001             CMB R34,=1
  178 060230 367 060             JZR INIRST
  179 060232             
  180 060232 236                 RTN
  181 060233             
  182 060233             
  183 060233             ! Power-on.  HP's INIT contract requires us to decide the ROMFL reason before
  184 060233             ! using registers below R34.  Having established ROMFL=0, R20+ are available.
  185 060233             !
  186 060233             ! RAMSIZ = 01600 octal = 896 decimal bytes.
  187 060233             ! Two-byte immediate 003/200 is encoded low byte first as =200,3.
  188 060233             
  189 060233 134 261 000 INIPWR  LDMD R34,=FWUSER
      060236 200 
  190 060237 263 154 205         STMD R34,=BAS241
  191 060242             
  192 060242 313 200 003         ADM R34,=200,3
  193 060245 263 000 200         STMD R34,=FWUSER
  194 060250             
  195 060250 316 376 011         JSB =ROMJSB
  196 060253 344 010             DEF SCRAT+
  197 060255 000                 BYT 0
  198 060256             
