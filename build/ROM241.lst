  954 062156             ! ------------------------------------------------------------
  955 062156             ! KRTPL -- RAM-trampoline template (copied to BAS241+KTRAMP).
  956 062156             !
  957 062156             ! IMPORTANT: the handled-key R6 manipulation occurs here, in RAM, only after
  958 062156             ! ROMJSB has returned and removed its own ROM-switching frame.  At that point
  959 062156             ! the stack layout is again the same as the physically-proven LOADBIN hook.
  960 062156             !
  961 062156             ! KHAND=0: unrelated key -> normal return through CHIDLE, native handling runs.
  962 062156             ! KHAND=1: COPY/PAPER/K1..K8 -> discard the two documented hook returns after
  963 062156             !                               ROMJSB unwinds, suppressing native handling.
  964 062156             ! ------------------------------------------------------------
  965 062156             
  966 062156 316 376 011 KRTPL   JSB =ROMJSB
  967 062161 210 144             DEF KHOOK
  968 062163 241                 BYT 241
