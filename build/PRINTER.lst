  232 000435             ! ============================================================
  233 000435             ! PRTKEYS RUNTIME -- v0.11b keyboard takeover control
  234 000435             !
  235 000435             !       PRTKEYS 1    install PRINTER85 COPY/PAPER CHIDLE hook
  236 000435             !       PRTKEYS 0    restore the exact previously saved CHIDLE bytes
  237 000435             !
  238 000435             ! PRTKEYS does not choose a printer.  Configure the independent keyboard
  239 000435             ! hardcopy profile first with PRTSET.  If no valid PRTSET profile exists,
  240 000435             ! COPY/PAPER are still consumed but produce no external-printer action.
  241 000435             !
  242 000435             ! All non-COPY/PAPER keys remain under normal HP-85 handling.
  243 000435             ! ============================================================
  244 000435             
  245 000435 241                 BYT 241
  246 000436             
