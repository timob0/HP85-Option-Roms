  263 000473 366 011             JNZ PKBAD
  264 000475             
  265 000475 176 310 000         CMB R76,=0
  266 000500 367 115             JZR PKOFF
  267 000502             
  268 000502 310 001             CMB R76,=1
  269 000504 367 004             JZR PKON
  270 000506             
  271 000506 316 211 015 PKBAD   JSB =ERRORP
  272 000511 131                 BYT 89D
  273 000512             
