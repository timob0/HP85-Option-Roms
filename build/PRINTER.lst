    1 000000             ! ============================================================
    2 000000             ! PRINTER85 v0.01a -- STANDALONE LOADBIN SPLIT
    3 000000             !
    4 000000             ! Extracted from the hardware-tested combined SIMON85 v0.11e source.
    5 000000             ! This is the verification-stage LOADBIN build prior to conversion to an
    6 000000             ! HP-85 Option ROM.  Printer algorithms and keyboard behavior are kept
    7 000000             ! logically unchanged from the combined build.
    8 000000             !
    9 000000             ! Public keywords:
   10 000000             !
   11 000000             !       PVER
   12 000000             !       PRTSCREEN device,driver[,zoom[,orientation]]
   13 000000             !       PRTSET    device,driver[,zoom[,orientation]]
   14 000000             !       PRTKEYS   mode
   15 000000             !
   16 000000             ! Driver 1 = HP ThinkJet 2225A
   17 000000             ! Driver 2 = SII IFD501 / CAPD345A
   18 000000             !
   19 000000             ! PRINTER85 is deliberately independent of SIMON85.  It has its own CRT row
   20 000000             ! reader, raster buffers, printer profile, HP-IB transport and CHIDLE state.
   21 000000             ! No SIMON85-local symbol or writable workspace is referenced.
   22 000000             ! ============================================================
   23 000000             
   24 000000 120 122 124         NAM PRT85
