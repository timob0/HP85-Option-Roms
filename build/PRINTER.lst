  171 000327             !       PRTSCREEN device,driver[,zoom[,orientation]]
  172 000327             !
  173 000327             ! The first two numeric expressions are required.  Optional third and
  174 000327             ! fourth expressions use the same trailing-comma pattern as CIRCLE.
  175 000327             ! Runtime distinguishes 2/3/4 REAL arguments from R12 versus TOS.
  176 000327             ! ============================================================
  177 000327             
