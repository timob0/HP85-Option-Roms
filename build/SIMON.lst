  427 001033 230                 BIN
  428 001034             
  429 001034             
  430 001034             ! ------------------------------------------------------------
  431 001034             ! SCALE 0,320,200,0 via Printer/Plotter ROM 360.
  432 001034             !
  433 001034             ! ROM360 token 8 (SCALE) has runtime entry 064041 octal.
  434 001034             ! The routine consumes four 8-byte numeric values from R12 in
  435 001034             ! the normal SCALE source order.  CONBIN converts the 16-bit
  436 001034             ! binary value in R36/R37 to an HP REAL in R40.
  437 001034             !
  438 001034             ! Constants below are octal:
  439 001034             !
  440 001034             !       320 decimal = 0500 octal = low 0100, high 0001
  441 001034             !       200 decimal = 0310 octal = low 0310, high 0000
  442 001034             !
  443 001034             ! An external-ROM call must go through ROMJSB even when the
  444 001034             ! caller is a RAM binary program.
  445 001034             ! ------------------------------------------------------------
  446 001034             
  447 001034 136 251 000         LDM R36,=0,0
      001037 000 
  448 001040 316 172 007         JSB =CONBIN
  449 001043 230                 BIN
  450 001044 140 012 345         PUMD R40,+R12
  451 001047             
  452 001047 136 251 100         LDM R36,=100,1
      001052 001 
  453 001053 316 172 007         JSB =CONBIN
  454 001056 230                 BIN
  455 001057 140 012 345         PUMD R40,+R12
  456 001062             
  457 001062 136 251 310         LDM R36,=310,0
      001065 000 
  458 001066 316 172 007         JSB =CONBIN
  459 001071 230                 BIN
  460 001072 140 012 345         PUMD R40,+R12
  461 001075             
  462 001075 136 251 000         LDM R36,=0,0
      001100 000 
  463 001101 316 172 007         JSB =CONBIN
  464 001104 230                 BIN
  465 001105 140 012 345         PUMD R40,+R12
