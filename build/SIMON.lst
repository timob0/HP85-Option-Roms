  496 001143             ! LINE RUNTIME -- v0.07c
  497 001143             !
  498 001143             !       LINE x1,y1,x2,y2,f
  499 001143             !
  500 001143             ! f=1:
  501 001143             !       ROM360 MOVE x1,y1
  502 001143             !       ROM360 DRAW x2,y2
  503 001143             !       Uses the current ROM360 PEN selected by HIRES j,k.
  504 001143             !       This physically-proven v0.07a path is unchanged.
  505 001143             !
  506 001143             ! f=0:
  507 001143             !       Direct CRT Bresenham raster path in CLEAR mode.
  508 001143             !       Nothing is sent to the physical plotter.
  509 001143             !
  510 001143             ! f=2:
  511 001143             !       Direct CRT Bresenham raster path in XOR mode.
  512 001143             !       Nothing is sent to the physical plotter.
  513 001143             !
  514 001143             ! v0.07c clips the f=0/f=2 mapped segment to the 256 x 192 CRT
  515 001143             ! before passing the accepted segment to the physically-proven
  516 001143             ! v0.07b Bresenham rasterizer.
