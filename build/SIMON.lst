    1 000000             ! ============================================================
    2 000000             ! SIMON85 v0.12b -- PRINTER-FREE GRAPHICS SPLIT / PLOTP KEYWORD FIX
    3 000000             !
    4 000000             ! Derived from the hardware-tested combined SIMON85 v0.11e source.
    5 000000             ! Retains the v0.11d incremental ARC/CIRCLE trigonometry optimization
    6 000000             ! and the v0.11e streamed MOVE/DRAW polyline optimization.
    7 000000             !
    8 000000             ! Public keywords:
    9 000000             !
   10 000000             !       SVER
   11 000000             !       BLOCK x1,y1,x2,y2,f
   12 000000             !       HIRES j,k
   13 000000             !       LINE x1,y1,x2,y2,f
   14 000000             !       REC x,y,b,h,f
   15 000000             !       ARC mx,my,ws,we,ww,rx,ry,f
   16 000000             !       CIRCLE x,y,rx,ry,f[,n]
   17 000000             !       ANGL x,y,w,rx,ry,f
   18 000000             !       PAINT x,y,f
   19 000000             !       PLOTP x,y,f
   20 000000             !       TEST(x,y)
   21 000000             !
   22 000000             ! f: 0=CLEAR, 1=SET, 2=XOR
   23 000000             !
   24 000000             ! PRINTER85 is deliberately independent.  This source contains no printer
   25 000000             ! drivers, HP-IB hardcopy transport, PRTSET/PRTKEYS state, or CHIDLE hook.
   26 000000             ! Normal f=1 vector graphics still use HP Printer/Plotter ROM 360 for the
   27 000000             ! established device-aware GCLEAR/SCALE/PEN/MOVE/DRAW services.
   28 000000             ! ============================================================
