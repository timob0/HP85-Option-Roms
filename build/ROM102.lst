  403 061035             ! ============================================================
  404 061035             ! ROM-SAFE PARSER GATEWAYS
  405 061035             !
  406 061035             ! Parser helpers may select ROM 0 or other ROMs internally.  ROMJSB
  407 061035             ! restores SIMON85 before returning to these wrappers.  Completed parse
  408 061035             ! routines themselves leave through ROMRTN so the interpreter regains ROM 0.
  409 061035             ! ============================================================
  410 061035             
  411 061035 316 376 011 P_SCAN  JSB =ROMJSB
  412 061040 262 022             DEF SCAN
  413 061042 000                 BYT 0
  414 061043 236                 RTN
  415 061044             
