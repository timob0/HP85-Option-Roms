  211 060403             ! CIRCLE PARSER
  212 060403             !
  213 060403             !       CIRCLE x,y,rx,ry,f[,n]
  214 060403             !
  215 060403             ! The first five numeric expressions are required.  After the
  216 060403             ! fifth NUMVAL, R14 already contains the next SCAN token.  HP's
  217 060403             ! own GCURSOR sample uses token 054 octal to detect an optional
  218 060403             ! trailing comma; NUMVP (NUMVA+) then SCANs and parses the sixth
  219 060403             ! numeric expression.
  220 060403             ! ============================================================
  221 060403             
  222 060403 143 006 344 CIRCLP  PUBD R43,+R6
  223 060406             
  224 060406 316 044 142         JSB =P_NUMVP
  225 060411 370 002             JEN C1OK
  226 060413 360 071             JMP CERR
  227 060415             
  228 060415 316 053 142 C1OK    JSB =P_GETCM
  229 060420 316 062 142         JSB =P_NUMVL
  230 060423 371 061             JEZ CERR
  231 060425             
  232 060425 316 053 142         JSB =P_GETCM
  233 060430 316 062 142         JSB =P_NUMVL
  234 060433 371 051             JEZ CERR
  235 060435             
