 2729 066773             !       SWW   = angular increment in degrees
 2730 066773             !
 2731 066773             ! Persistent recurrence state:
 2732 066773             !       RSIN  = sin(current angle)
 2733 066773             !       RCOS  = cos(current angle)
 2734 066773             !       RDSIN = sin(step)
 2735 066773             !       RDCOS = cos(step)
