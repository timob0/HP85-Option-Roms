  113 060174 313 204 012         ADM R34,=204,12  ! +05204 octal bytes (low byte 0204, high 0012)
  114 060177 263 000 200         STMD R34,=FWUSER
  115 060202             
  116 060202 316 376 011         JSB =ROMJSB
