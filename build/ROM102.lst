  491 061131             ! ROM360 token 5 (GCLEAR) has runtime entry 064557 octal.
  492 061131             ! This uses the same device-aware graphics layer as the SCALE
  493 061131             ! and PEN calls below.  No optional parameter is supplied.
  494 061131             ! ------------------------------------------------------------
  495 061131             
  496 061131 316 376 011         JSB =ROMJSB
  497 061134 157 151             DEF PPGCLR
  498 061136 360                 BYT 360
  499 061137 230                 BIN
  500 061140             
  501 061140             
  502 061140             ! ------------------------------------------------------------
  503 061140             ! SCALE 0,320,200,0 via Printer/Plotter ROM 360.
  504 061140             !
  505 061140             ! ROM360 token 8 (SCALE) has runtime entry 064041 octal.
  506 061140             ! The routine consumes four 8-byte numeric values from R12 in
  507 061140             ! the normal SCALE source order.  CONBIN converts the 16-bit
  508 061140             ! binary value in R36/R37 to an HP REAL in R40.
  509 061140             !
  510 061140             ! Constants below are octal:
  511 061140             !
  512 061140             !       320 decimal = 0500 octal = low 0100, high 0001
  513 061140             !       200 decimal = 0310 octal = low 0310, high 0000
  514 061140             !
  515 061140             ! An external-ROM call must go through ROMJSB even when the
  516 061140             ! caller is a RAM binary program.
  517 061140             ! ------------------------------------------------------------
  518 061140             
  519 061140 136 251 000         LDM R36,=0,0
      061143 000 
  520 061144 316 172 007         JSB =CONBIN
  521 061147 230                 BIN
  522 061150 140 012 345         PUMD R40,+R12
  523 061153             
  524 061153 136 251 100         LDM R36,=100,1
      061156 001 
  525 061157 316 172 007         JSB =CONBIN
  526 061162 230                 BIN
  527 061163 140 012 345         PUMD R40,+R12
  528 061166             
  529 061166 136 251 310         LDM R36,=310,0
      061171 000 
  530 061172 316 172 007         JSB =CONBIN
  531 061175 230                 BIN
