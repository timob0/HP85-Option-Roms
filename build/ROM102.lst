  422 061056 014 027             DEF GETCM
  423 061060 000                 BYT 0
  424 061061 236                 RTN
  425 061062             
  426 061062 316 376 011 P_NUMVL JSB =ROMJSB
  427 061065 012 025             DEF NUMVAL
  428 061067 000                 BYT 0
  429 061070 236                 RTN
