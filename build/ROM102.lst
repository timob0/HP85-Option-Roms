    1 000000             ! ============================================================
    2 000000             ! SIMON85 v0.13a2 -- HP-85 OPTION ROM CONVERSION / FINAL GLOBAL-SYMBOL WARNING CLEANUP
    3 000000             !
    4 000000             ! Functionally based on v0.12b.  First option-ROM development build.
    5 000000             ! ROM number 102 octal; writable workspace is reserved in RAM via UNBAS2.
    6 000000             !
    7 000000             ! Derived from the hardware-tested combined SIMON85 v0.11e source.
    8 000000             ! Retains the v0.11d incremental ARC/CIRCLE trigonometry optimization
    9 000000             ! and the v0.11e streamed MOVE/DRAW polyline optimization.
   10 000000             !
   11 000000             ! Public keywords:
   12 000000             !
   13 000000             !       SVER
   14 000000             !       BLOCK x1,y1,x2,y2,f
   15 000000             !       HIRES j,k
   16 000000             !       LINE x1,y1,x2,y2,f
   17 000000             !       REC x,y,b,h,f
   18 000000             !       ARC mx,my,ws,we,ww,rx,ry,f
   19 000000             !       CIRCLE x,y,rx,ry,f[,n]
   20 000000             !       ANGL x,y,w,rx,ry,f
   21 000000             !       PAINT x,y,f
   22 000000             !       PLOTP x,y,f
   23 000000             !       TEST(x,y)
   24 000000             !
   25 000000             ! f: 0=CLEAR, 1=SET, 2=XOR
   26 000000             !
   27 000000             ! PRINTER85 is deliberately independent.  This source contains no printer
   28 000000             ! drivers, HP-IB hardcopy transport, PRTSET/PRTKEYS state, or CHIDLE hook.
   29 000000             ! Normal f=1 vector graphics still use HP Printer/Plotter ROM 360 for the
   30 000000             ! established device-aware GCLEAR/SCALE/PEN/MOVE/DRAW services.
   31 000000             ! ============================================================
   32 000000             
   33 000000             ! OPTION-ROM BUILD NOTES:
   34 000000             !   - assembled origin: 60000 octal
   35 000000             !   - ROM number: 102 octal; complement 275 octal
   36 000000             !   - requires HP Printer/Plotter ROM 360
   37 000000             !   - reserves 5204 octal (2692 decimal) bytes of RAM via UNBAS2 at power-on
   38 000000             !   - intended to coexist with PRINTER85 when PRINTER85 uses a different
   39 000000             !     stolen-RAM base pointer / ROM number.
   40 000000             !
   41 000000                     ABS ROM 60000
   42 060000             
   43 060000             ROMNUM  EQU 102       ! SIMON85 option-ROM number (octal)
   44 060000             
   45 060000 102                 BYT 102       ! ROM number -- must be first byte
   46 060001 275                 BYT 275       ! ones-complement of ROM number
   47 060002 044 140             DEF RUNTIM
   48 060004 076 140             DEF KWTABL
   49 060006 014 140             DEF PARSE
   50 060010 156 140             DEF ERMSG
   51 060012 157 140             DEF INIT
   52 060014             
