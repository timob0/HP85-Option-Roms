10 REM CPM85 / EBTKS AUXROM KEYBOARD BUFFER TEST 0.01A
20 REM RUN THIS FROM A BASIC PROGRAM, NOT CALCULATOR MODE
30 REM DISABLE PRTKEYS 1 BEFORE TESTING (PRTKEYS 0)
40 DISP "CPM85 KEY TEST - SHIFT+K4 (K8) QUITS"
50 PRINT "KEY CODES: K8 SHOULD BE 135 DEC (207 OCT)"
60 KBDBUFFER 1
70 IF KBDISKEY=0 THEN 70
80 K=KBDKEY
90 PRINT K
100 IF K=135 THEN 130
110 GOTO 70
130 KBDBUFFER 0
140 DISP "KEYBOARD RELEASED - BACK IN HP BASIC"
150 END
