10 REM CPM85 FOREGROUND CONSOLE SKELETON V0.01A
20 REM DISPLAY ONLY - NEVER USES PRINTER IS
30 REM EXIT OLD CPM CAPTURE WITH K8 BEFORE RUN
40 REM IF PRTKEYS IS ACTIVE, ENTER PRTKEYS 0 FIRST
50 REM EBTKS KEYBOARD BUFFER AS IN CPMKEYS.BAS
60 REM K1=128 K2=129 K3=130 K4=131 K8=135
70 M=0
80 P=1
90 KBDBUFFER 1
100 GOSUB 500
110 IF KBDISKEY=0 THEN 110
120 K=KBDKEY
130 IF K=135 THEN 400
140 IF K=131 THEN 300
150 IF M=1 THEN 110
160 IF K=128 THEN P=1
170 IF K=129 THEN P=2
180 IF K=130 THEN P=3
190 IF K<128 THEN 110
200 IF K>130 THEN 110
210 GOSUB 500
220 GOTO 110
300 IF M=0 THEN 340
310 M=0
320 GOSUB 500
330 GOTO 110
340 M=1
350 GOSUB 500
360 GOTO 110
400 KBDBUFFER 0
410 DISP "CPM85 CONSOLE DEMO FINISHED"
420 END
500 IF M=1 THEN 700
510 IF P=1 THEN 600
520 IF P=2 THEN 630
530 GOTO 660
600 DISP "DRIVES: K1-3 PG K4 CPM K8 END"
610 RETURN
630 DISP "DEVICES: K1-3 PG K4 CPM K8 END"
640 RETURN
660 DISP "SYSTEM: K1-3 PG K4 CPM K8 END"
670 RETURN
700 DISP "CP/M DEMO: K4 MENU K8 EXIT"
710 RETURN
