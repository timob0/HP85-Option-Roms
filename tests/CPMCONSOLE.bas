10 REM CPM85 FOREGROUND CONSOLE SKELETON V0.01A
20 REM EXPERIMENTAL - DOES NOT CHANGE CPM85 LOADBIN
30 REM EXIT OLD CPM CAPTURE WITH K8 BEFORE RUN
40 REM IF PRTKEYS IS ACTIVE, ENTER PRTKEYS 0 FIRST
50 REM USES EBTKS KBDBUFFER AS IN CPMKEYS.BAS
60 REM K1=128 K2=129 K3=130 K4=131 K8=135
70 M=0
80 P=1
90 KBDBUFFER 1
100 GOSUB 500
110 IF KBDISKEY=0 THEN 110
120 K=KBDKEY
130 IF K=135 THEN 400
140 IF K=131 THEN 300
150 IF M=1 THEN 110
160 IF K=128 THEN P=1
170 IF K=129 THEN P=2
180 IF K=130 THEN P=3
190 IF K<128 THEN 110
200 IF K>130 THEN 110
210 GOSUB 500
220 GOTO 110
300 IF M=0 THEN 340
310 M=0
320 GOSUB 500
330 GOTO 110
340 M=1
350 GOSUB 500
360 GOTO 110
400 KBDBUFFER 0
410 DISP "CPM85 CONSOLE DEMO FINISHED"
420 END
500 PRINT
510 PRINT "CPM85 CONSOLE V0.01A"
520 PRINT "------------------------------"
530 IF M=1 THEN 700
540 PRINT "MANAGEMENT MODE"
550 PRINT "K1 DRIVES    K2 DEVICES"
560 PRINT "K3 SYSTEM    K4 CP/M"
570 PRINT "K8 EXIT"
580 IF P=1 THEN 610
590 IF P=2 THEN 640
600 GOTO 670
610 PRINT "DRIVES PAGE"
620 PRINT "MOUNTS: NOT CONNECTED"
630 RETURN
640 PRINT "DEVICES PAGE"
650 PRINT "PRINTER: NOT CONNECTED"
660 RETURN
670 PRINT "SYSTEM PAGE"
680 PRINT "STATUS: NOT CONNECTED"
690 RETURN
700 PRINT "CP/M CONTROL - TEST ONLY"
710 PRINT "K4 MANAGEMENT   K8 EXIT"
720 PRINT "KEYS ARE NOT FORWARDED"
730 PRINT "LST: NOT READY"
740 RETURN
